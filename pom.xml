<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.entur.ror</groupId>
        <artifactId>superpom</artifactId>
        <version>7.0.0</version>
    </parent>

    <groupId>org.rutebanken</groupId>
    <artifactId>tiamat-parent</artifactId>
    <version>0.0.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Tiamat Parent</name>
    <description>Stop place register / holdeplassregister</description>

    <licenses>
        <license>
            <name>EUPL-1.2 with modifications</name>
            <url>https://joinup.ec.europa.eu/software/page/eupl</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>Entur AS</name>
        <url>http://www.entur.org/</url>
    </organization>

    <scm>
        <connection>scm:git:ssh://git@github.com:entur/tiamat.git</connection>
        <developerConnection>scm:git:ssh://git@github.com:entur/tiamat.git</developerConnection>
    </scm>

    <modules>
        <module>tiamat-core</module>
        <module>tiamat-app</module>
    </modules>

    <properties>
        <!--
          java.version must live here rather than in tiamat-core/pom.xml: superpom maps it to
          maven.compiler.release, and a property set only in a leaf module does not apply to a
          sibling module (tiamat-app) that merely depends on that leaf as a jar - it would
          silently fall back to the superpom's own default instead.
        -->
        <java.version>25</java.version>
        <hazelcast.version>5.2.5</hazelcast.version>
        <hazelcast-hibernate53.version>5.2.0</hazelcast-hibernate53.version>
        <graphql-java.version>20.9</graphql-java.version>
        <graphql-java-extended-scalars.version>20.2</graphql-java-extended-scalars.version>
        <spring-cloud-aws.version>4.0.2</spring-cloud-aws.version>
    </properties>

    <!--
      Dependency versions pinned here (rather than in tiamat-core/pom.xml) so they apply
      consistently to every module in the reactor. dependencyManagement declared in a leaf
      module only affects that module's own resolution - a sibling module (e.g. tiamat-app)
      that merely depends on tiamat-core as a jar does not inherit it, and would otherwise
      silently fall back to whatever version the superpom/Spring Boot BOM manages instead.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Aligns all io.awspring.cloud:* artifacts (incl. transitive spring-cloud-aws-autoconfigure)
                 to a single, Spring Boot 4 compatible version. Without this BOM, bumping only the
                 starter version leaves the transitive autoconfigure unmanaged and prone to version skew. -->
            <dependency>
                <groupId>io.awspring.cloud</groupId>
                <artifactId>spring-cloud-aws-dependencies</artifactId>
                <version>${spring-cloud-aws.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.hazelcast</groupId>
                <artifactId>hazelcast</artifactId>
                <version>${hazelcast.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hazelcast</groupId>
                <artifactId>hazelcast-spring</artifactId>
                <version>${hazelcast.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hazelcast</groupId>
                <artifactId>hazelcast-hibernate53</artifactId>
                <version>${hazelcast-hibernate53.version}</version>
            </dependency>
            <dependency>
                <groupId>com.graphql-java</groupId>
                <artifactId>graphql-java</artifactId>
                <version>${graphql-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.graphql-java</groupId>
                <artifactId>graphql-java-extended-scalars</artifactId>
                <version>${graphql-java-extended-scalars.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
